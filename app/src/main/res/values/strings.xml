    <string name="help">User Help</string>
    <string name="help_welcome_title">Welcome to My Checks</string>
    <string name="help_welcome_desc">Your modern native Android companion for safety inspections, operational checklists, submissions, and PDF reports.</string>
    <string name="help_sec1_title">1. Dashboard &amp; Navigation</string>
    <string name="help_sec1_desc">The Dashboard is your starting point. Use the top cards to navigate to Checklists or Submissions, and access Settings or Help from the top bar.</string>
    <string name="help_sec2_title">2. Managing Checklists</string>
    <string name="help_sec2_desc">Create, search, and filter checklists by category. Each checklist card allows filling, managing questions, editing, or deleting with automatic cascade.</string>
    <string name="help_sec3_title">3. Questions &amp; Reordering</string>
    <string name="help_sec3_desc">Add questions with custom answer types (text, number, checkbox, combobox, NFC, QR). Use Up/Down arrows to easily reorder question sequence.</string>
    <string name="help_sec4_title">4. Supported Answer Types</string>
    <string name="help_sec4_desc">Text &amp; Number: Flexible text comments and validated numeric input. Checkbox &amp; Combobox: Yes/No toggles and single-choice options. NFC &amp; QR Code: Tap physical NFC tags or scan QR codes using camera.</string>
    <string name="help_sec5_title">5. Filling Out &amp; Submitting</string>
    <string name="help_sec5_desc">Enter inspector details, check date, and optional notes. Answer all required checklist questions and submit results securely.</string>
    <string name="help_sec6_title">6. Submissions &amp; PDF Export</string>
    <string name="help_sec6_desc">View recorded submissions, filter by checklist or status, edit answers, and instantly export professional A4 PDF inspection reports.</string>
    <string name="help_sec7_title">7. App Settings &amp; Categories</string>
    <string name="help_sec7_desc">Customize appearance theme (System, Light, Dark), preferred language, default inspector username, and manage custom database categories.</string>
